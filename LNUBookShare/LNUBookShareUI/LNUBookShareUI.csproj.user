<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup />
  <ItemGroup>
    <ApplicationDefinition Update="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>
  <!-- Блок <Compile> (для C# файлів) -->
  <ItemGroup>
    <Compile Update="Views\AddBookView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\EditBookView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\LoginView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\MainView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <!-- Ось твої відсутні/зламані теги -->
    <Compile Update="Views\RegisterView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\ProfileView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <!-- Блок <Page> (для XAML файлів) -->
  <ItemGroup>
    <!-- 👇 ДОДАНО ВІДСУТНІ ФАЙЛИ -->
    <Page Update="Views\AddBookView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\EditBookView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\LoginView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\RegisterView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <!-- 👆 КІНЕЦЬ ДОДАНИХ ФАЙЛІВ -->
    <Page Update="Views\MainView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\ProfileView.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>