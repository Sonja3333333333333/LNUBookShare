<Window x:Class="LNUBookShareUI.Views.EditBookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditBookViewModel}"
        Title="Редагувати книгу" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Фото -->
            <RowDefinition Height="*"/>
            <!-- Форма -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Редагувати книгу" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left" 
                   Margin="0,0,0,20"/>

        <!-- Блок фото -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Border Width="120" Height="160" 
                    Background="White"
                    BorderBrush="Black" 
                    BorderThickness="1"
                    HorizontalAlignment="Left">
                <Grid>
                    <!-- Placeholder "X" -->
                    <Path Data="M 0,0 L 120,160 M 120,0 L 0,160" 
                          Stroke="LightGray" 
                          StrokeThickness="1"/>

                    <!-- Зображення -->
                    <Image Source="{Binding CoverPath}" 
                           Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <!-- Кнопка "Додати (Змінити) фото" -->
            <Button Content="Додати (Змінити) фото" 
                    Command="{Binding ChangePhotoCommand}"
                    Margin="0,10,0,0" 
                    Padding="10,5"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#0078D7"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{TemplateBinding Content}" 
                                               Foreground="{TemplateBinding Foreground}"
                                               TextDecorations="Underline"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Форма -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Назва -->
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,10"
                         BorderBrush="Black"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Назва" 
                                                               Foreground="Gray" 
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Автор -->
                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,10"
                         BorderBrush="Black"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Автор" 
                                                               Foreground="Gray" 
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- ISBN -->
                <TextBox Text="{Binding ISBN, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,10"
                         BorderBrush="Black"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="ISBN" 
                                                               Foreground="Gray" 
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Рік видання -->
                <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,10"
                         BorderBrush="Black"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Рік видання" 
                                                               Foreground="Gray" 
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Видавництво -->
                <TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,10"
                         BorderBrush="Black"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Видавництво" 
                                                               Foreground="Gray" 
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Мова -->
                <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,0,10"
                         BorderBrush="Black"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Мова" 
                                                               Foreground="Gray" 
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Категорія -->
                <ComboBox ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}"
                          Height="35" 
                          VerticalContentAlignment="Center" 
                          Margin="0,0,0,15"
                          BorderBrush="Black"
                          BorderThickness="1">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- Статус книги -->
                <TextBlock Text="Статус книги:" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                    <RadioButton Content="Доступна" 
                                 GroupName="Status" 
                                 Margin="0,0,0,5"
                                 Tag="available"
                                 Checked="StatusRadioButton_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="available">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="Видана" 
                                 GroupName="Status"
                                 Tag="issued"
                                 Checked="StatusRadioButton_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="issued">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки "Скасувати" та "Зберегти" -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Скасувати" 
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="40" 
                    FontSize="14"
                    Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1"/>

            <Button Grid.Column="2" 
                    Content="Зберегти" 
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="40" 
                    FontSize="14" 
                    FontWeight="Bold"
                    Background="#0078D7" 
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>