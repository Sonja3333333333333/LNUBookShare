<Window x:Class="LNUBookShareUI.Views.EditBookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditBookViewModel}"
        Title="Редагувати книгу" Height="750" Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border Width="150" Height="220" BorderBrush="Gray" BorderThickness="1" Background="Gainsboro" ClipToBounds="True">
                <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
            </Border>
            <Button Content="Змінити обкладинку" Margin="0,10,0,0" Command="{Binding ChangeCoverCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Назва книги*"/>
        <TextBox Grid.Row="1" Text="{Binding Title}" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="2" Text="Автор*"/>
        <TextBox Grid.Row="2" Text="{Binding Author}" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="3" Text="Категорія*"/>
        <ComboBox Grid.Row="3" Margin="0,20,0,10"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="4" Text="Рік видання"/>
        <TextBox Grid.Row="4" Text="{Binding Year}" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="5" Text="Видавництво"/>
        <TextBox Grid.Row="5" Text="{Binding Publisher}" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="6" Text="Мова"/>
        <TextBox Grid.Row="6" Text="{Binding Language}" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="7" Text="ISBN"/>
        <TextBox Grid.Row="7" Text="{Binding Isbn}" Margin="0,20,0,10"/>

        <TextBlock Grid.Row="8" Text="Статус*"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,20,0,10">

            <RadioButton Content="Доступна" GroupName="Status">
                <RadioButton.Style>
                    <Style TargetType="RadioButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="available">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
                <RadioButton.Tag>
                    <MultiBinding ConverterParameter="available">
                        <Binding Path="IsChecked"/>
                        <Binding Path="Status"/>
                    </MultiBinding>
                </RadioButton.Tag>
            </RadioButton>

            <RadioButton Content="Видана" GroupName="Status" Margin="10,0,0,0">
                <RadioButton.Style>
                    <Style TargetType="RadioButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="issued">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
                <RadioButton.Tag>
                    <MultiBinding ConverterParameter="issued">
                        <Binding Path="IsChecked"/>
                        <Binding Path="Status"/>
                    </MultiBinding>
                </RadioButton.Tag>
            </RadioButton>

        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Width="100" Margin="0,0,10,0" IsCancel="True"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Content="Зберегти" Width="100" IsDefault="True"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </Grid>
</Window>