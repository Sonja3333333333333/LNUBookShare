<Window x:Class="LNUBookShareUI.Views.ProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}"
        Title="{Binding Profile.FullName, FallbackValue='Профіль'}" Height="700" Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock>
                            <Hyperlink TextDecorations="None" Foreground="#0078D7">
                                <Run Text="{TemplateBinding Content}"/>
                            </Hyperlink>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <TextBlock TextDecorations="Underline" Foreground="#005A9E">
                                    <Run Text="{TemplateBinding Content}"/>
                                </TextBlock>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,5" Command="{Binding GoBackCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="100" Height="100" Margin="0,0,20,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Profile.AvatarPath}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.FullName}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Profile.Email}" FontSize="14" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Profile.FacultyName}" FontSize="14" FontStyle="Italic"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✏️" FontSize="20" VerticalAlignment="Top"
                        Width="40" Height="40" ToolTip="Редагувати профіль"
                        Visibility="{Binding IsMyProfile, Converter={StaticResource BoolToVis}}"
                        Command="{Binding OpenEditProfileCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Книги користувача"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMyProfile}" Value="True">
                                <Setter Property="Text" Value="Мої книги"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Label Content="Сортувати:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding SortOptions}" 
                          SelectedValue="{Binding SelectedSort}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          VerticalAlignment="Center" MinWidth="100"/>

                <Separator Width="20" Background="Transparent"/>
                <RadioButton Content="Усі" GroupName="StatusFilter" VerticalAlignment="Center"
                             Command="{Binding SetFilterAllCommand}" IsChecked="True"/>
                <RadioButton Content="Тільки доступні" GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterAvailableCommand}"/>
                <RadioButton Content="Тільки видані" GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterIssuedCommand}"/>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="3" 
                  ItemsSource="{Binding OwnedBooksView}" 
                  HorizontalContentAlignment="Stretch"
                  BorderThickness="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,8" Height="100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="60" Height="80" Background="Gainsboro" ClipToBounds="True">
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Назва: " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button 
                                        Content="{Binding Title}"
                                        FontSize="14" FontWeight="Bold" 
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource LinkButton}" Padding="0"
                                        Command="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding BookId}"/>
                                </StackPanel>

                                <TextBlock FontStyle="Italic" Margin="0,5,0,5">
                                    <Run Text="Автор: "/>
                                    <Run Text="{Binding Author}"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Статус: " FontWeight="Bold"/>
                                    <Run Text="{Binding Status}"/>
                                    <Run Text="  |  "/>
                                    <Run Text="Рік: " FontWeight="Bold"/>
                                    <Run Text="{Binding Year}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Content="✏️" FontSize="16" Width="35" Height="35" ToolTip="Редагувати книгу"
                                        Visibility="{Binding DataContext.IsMyProfile, 
                                                    RelativeSource={RelativeSource AncestorType=Window}, 
                                                    Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenEditBookCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding BookId}"/>
                                <Button Content="🗑️" FontSize="16" Width="35" Height="35" ToolTip="Видалити книгу"
                                        Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding BookId}"
                                        Margin="0,5,0,0"
                                        Visibility="{Binding DataContext.IsMyProfile, 
                                                    RelativeSource={RelativeSource AncestorType=Window}, 
                                                    Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="4" Content="+" FontSize="24" FontWeight="Bold"
                Width="50" Height="50" HorizontalAlignment="Center" Margin="0,10,0,0"
                ToolTip="Додати нову книгу"
                Visibility="{Binding IsMyProfile, Converter={StaticResource BoolToVis}}"
                Command="{Binding OpenAddBookCommand}"/>


        <Grid
            Background="#80000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
            Panel.ZIndex="100"
            Grid.RowSpan="5">


            <Path
                Style="{StaticResource LoadingSpinnerStyle}"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>