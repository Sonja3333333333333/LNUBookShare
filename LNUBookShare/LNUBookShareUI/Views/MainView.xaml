<Window x:Class="LNUBookShareUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        xmlns:common="clr-namespace:LNUBookShareUI.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Головне вікно" 
        Height="800" Width="1000" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">

    <Window.Resources>

        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F0FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavoritedByCurrentUser}" Value="True">
                    <Setter Property="Background" Value="#DC3545"/>
                    <Setter Property="ToolTip" Value="Видалити зі списку вподобань"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📚 LNUBookShare" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="❤️ Уподобані" Style="{StaticResource HeaderButtonStyle}" Command="{Binding OpenFavoritesCommand}" Margin="0,0,10,0" Padding="15,6"/>
                    <Button Content="👤 Мій профіль" Style="{StaticResource HeaderButtonStyle}" Command="{Binding OpenProfileCommand}" Padding="15,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" 
                              ItemsSource="{Binding SearchOptions}" 
                              SelectedValue="{Binding SelectedSearchCriteria}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              VerticalAlignment="Center"
                              Height="35"
                              Padding="5"
                              MinWidth="140"
                              Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalAlignment="Center" 
                             Height="35"
                             FontSize="14"
                             Padding="5"
                             Margin="0,0,10,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadBooksCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="2" 
                            Content="🔍 Пошук" 
                            Command="{Binding LoadBooksCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="100"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" FontSize="14" Margin="5,0,0,10" Foreground="{StaticResource TextSecondaryColor}">
                <Run Text="Знайдено результатів: "/>
                <Run Text="{Binding TotalResults}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}"/>
            </TextBlock>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="←" Command="{Binding PreviousPageCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="30" Padding="0"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0">
                            <Run Text="Стор." Foreground="{StaticResource TextSecondaryColor}"/>
                            <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                        </TextBlock>
                        <Button Content="→" Command="{Binding NextPageCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="30" Padding="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Сортувати:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryColor}"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" 
                                  SelectedValue="{Binding SelectedSort}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  Height="30"
                                  Padding="5"
                                  VerticalContentAlignment="Center"
                                  MinWidth="130"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="Усі" GroupName="StatusFilter" Command="{Binding SetFilterAllCommand}" Margin="0,0,10,0">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="All">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton Content="Доступні" GroupName="StatusFilter" Command="{Binding SetFilterAvailableCommand}" Margin="0,0,10,0">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Available">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton Content="Видані" GroupName="StatusFilter" Command="{Binding SetFilterIssuedCommand}">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Issued">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <ListView Grid.Row="3" 
                      ItemsSource="{Binding Books}" 
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,5,10" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Width="80" Height="110" 
                                        Margin="0,0,20,0" 
                                        VerticalAlignment="Center" 
                                        Background="#FAFAFA" 
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <Button Content="{Binding Title}" 
                                            Style="{StaticResource LinkButtonStyle}"
                                            FontSize="18" 
                                            FontWeight="Bold" 
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,5"
                                            Command="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding BookId}"/>

                                    <TextBlock Text="{Binding Author}" FontStyle="Italic" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Власник: " Foreground="{StaticResource TextSecondaryColor}"/>
                                        <Button Content="{Binding OwnerFullName}"
                                                Style="{StaticResource LinkButtonStyle}"
                                                FontSize="14"
                                                Command="{Binding DataContext.ViewOwnerProfileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding OwnerId}"/>
                                    </StackPanel>

                                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryColor}">
                                        <Run Text="Статус:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Status}" Foreground="{StaticResource TextPrimaryColor}"/>
                                        <Run Text=" | "/>
                                        <Run Text="Рік:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Year}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        Style="{StaticResource FavoriteToggleButtonStyle}"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding BookId}"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0" 
                                        Width="140"
                                        Padding="10,8">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="♡ Вподобати"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavoritedByCurrentUser}" Value="True">
                                                        <Setter Property="Text" Value="❤️ Видалити"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>