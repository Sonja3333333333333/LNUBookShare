<Window x:Class="LNUBookShareUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        xmlns:common="clr-namespace:LNUBookShareUI.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Головне вікно" Height="600" Width="800" MinWidth="600">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock>
                            <Hyperlink TextDecorations="None" Foreground="#0078D7">
                                <Run Text="{TemplateBinding Content}"/>
                            </Hyperlink>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <TextBlock TextDecorations="Underline" Foreground="#005A9E">
                                    <Run Text="{TemplateBinding Content}"/>
                                </TextBlock>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

     

    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Уподобані" Style="{StaticResource LinkButton}" Command="{Binding OpenFavoritesCommand}" />
            <Button Content="Профіль" Style="{StaticResource LinkButton}" Margin="10,0,0,0" Command="{Binding OpenProfileCommand}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" 
                      ItemsSource="{Binding SearchOptions}" 
                      SelectedValue="{Binding SelectedSearchCriteria}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      VerticalAlignment="Center"
                      MinWidth="120"/>

            <TextBox Grid.Column="1" 
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="10,0" VerticalAlignment="Center" FontSize="14">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding LoadBooksCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="2" 
                    Content="Пошук" 
                    Command="{Binding LoadBooksCommand}" 
                    Padding="10,5"/>
        </Grid>

        <TextBlock Grid.Row="2" FontSize="14" Margin="0,15,0,5">
            <Run Text="Знайдено результатів: "/>
            <Run Text="{Binding TotalResults}" FontWeight="Bold"/>
        </TextBlock>

        <Grid Grid.Row="3" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="←" Command="{Binding PreviousPageCommand}" FontWeight="Bold" Width="30"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0">
                    <Run Text="Сторінка:"/>
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                </TextBlock>
                <Button Content="→" Command="{Binding NextPageCommand}" FontWeight="Bold" Width="30"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                <Label Content="Сортувати:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding SortOptions}" 
                          SelectedValue="{Binding SelectedSort}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          VerticalAlignment="Center"
                          MinWidth="100"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton Content="Усі"
                             GroupName="StatusFilter" VerticalAlignment="Center"
                             Command="{Binding SetFilterAllCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="All">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="Тільки доступні"
                             GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterAvailableCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Available">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="Тільки видані"
                             GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterIssuedCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Issued">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="4" ItemsSource="{Binding Books}" HorizontalContentAlignment="Stretch">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Style>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,8" Height="120">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Цей Border слугує і фоном-заглушкою, і контейнером -->
                            <Border Grid.Column="0"
                                Width="80" Height="100"
                                Margin="0,0,15,0" VerticalAlignment="Center"
                                Background="Gainsboro" 
                                ClipToBounds="True">
                                                        <!-- 2. Це обріже зображення по краях Border -->

                                                        <!-- 3. Прив'язуємо Image до 'CoverPath' з DTO -->
                                <Image Source="{Binding CoverPath}"
                                   Stretch="UniformToFill" />
                                                        <!-- 4. "UniformToFill" гарно заповнює простір -->
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button 
                                    Content="{Binding Title}" 
                                    FontSize="16" FontWeight="Bold" 
                                    Margin="0,0,0,5"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0" 
                                    Command="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                    />  
                                <TextBlock Text="{Binding Author}" FontStyle="Italic" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Year, StringFormat='Рік: {0}'}"/>
                                <!--<TextBlock Text="{Binding OwnerFullName  , StringFormat='Власник: {0}'}"/>-->
                                <Button 
                                    Content="{Binding OwnerFullName, StringFormat='Власник: {0}'}"
                                    Command="{Binding DataContext.ViewOwnerProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding OwnerId}"
                                    Style="{StaticResource LinkButton}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Cursor="Hand"
                                />                            

                            </StackPanel>

                            <Button Grid.Column="2" 
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Width="120" Height="30">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="♡ Вподобати"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavoritedByCurrentUser}" Value="True">
                                                    <Setter Property="Text" Value="❤️ Видалити"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>