<Window x:Class="LNUBookShareUI.Views.FavoritesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        xmlns:common="clr-namespace:LNUBookShareUI.Common"
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=vm:FavoritesViewModel}"
        Title="Уподобане" 
        Height="750" Width="900" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">

    <Window.Resources>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Cursor="Hand"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearAllButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DC3545"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.05" Duration="0:0:0.2"/>
                            
                            </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                                Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.0" Duration="0:0:0.2"/>
                            
                            </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
                Content="← Назад" 
                Command="{Binding GoBackCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalAlignment="Left" 
                Background="Transparent"
                BorderThickness="0"
                Foreground="{StaticResource TextSecondaryColor}"
                Margin="0,0,0,10"
                Cursor="Hand"
                FontSize="14"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" Command="{Binding PreviousPageCommand}" Width="30" Height="30" Padding="0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0">
                        <Run Text="Стор." Foreground="{StaticResource TextSecondaryColor}"/>
                        <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                    </TextBlock>
                    <Button Content="→" Command="{Binding NextPageCommand}" Width="30" Height="30" Padding="0" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортувати:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryColor}"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" 
                              SelectedValue="{Binding SelectedSort}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              Width="150"
                              Height="30"
                              Padding="5"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Усі" GroupName="StatusFilter" Command="{Binding SetFilterAllCommand}" Margin="0,0,10,0">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="All">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="Доступні" GroupName="StatusFilter" Command="{Binding SetFilterAvailableCommand}" Margin="0,0,10,0">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Available">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton Content="Видані" GroupName="StatusFilter" Command="{Binding SetFilterIssuedCommand}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Issued">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" FontSize="14" Margin="5,0,0,10" Foreground="{StaticResource TextSecondaryColor}">
            <Run Text="Знайдено вподобань: "/>
            <Run Text="{Binding TotalResults}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}"/>
        </TextBlock>

        <ListView Grid.Row="3" ItemsSource="{Binding FavoriteBooks}" 
                  HorizontalContentAlignment="Stretch" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  BorderThickness="0">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,5,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="70" Height="100" 
                                    Margin="0,0,15,0" 
                                    BorderBrush="{StaticResource BorderColor}" 
                                    BorderThickness="1" 
                                    CornerRadius="5"
                                    Background="#FAFAFA" 
                                    ClipToBounds="True">
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="{Binding Title}" 
                                        Style="{StaticResource LinkButtonStyle}"
                                        FontSize="18" 
                                        FontWeight="Bold" 
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,3"
                                        Command="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding BookId}"/>

                                <TextBlock Text="{Binding Author}" FontStyle="Italic" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Власник: " Foreground="{StaticResource TextSecondaryColor}"/>
                                    <Button Content="{Binding OwnerFullName}"
                                            Style="{StaticResource LinkButtonStyle}"
                                            FontSize="14"
                                            Command="{Binding DataContext.ViewOwnerProfileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding OwnerId}"/>
                                </StackPanel>

                                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryColor}">
                                    <Run Text="Статус:" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Status}" Foreground="{StaticResource TextPrimaryColor}"/>
                                    <Run Text=" | "/>
                                    <Run Text="Рік:" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Year}"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="2" 
                                    Style="{StaticResource RemoveButtonStyle}"
                                    Command="{Binding DataContext.RemoveFromFavoritesCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Padding="15,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❤️" Margin="0,0,5,0"/>
                                    <TextBlock Text="Видалити"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="4" 
                Content="🗑️ Очистити список вподобань" 
                Command="{Binding ClearFavoritesCommand}"
                Style="{StaticResource ClearAllButtonStyle}"
                HorizontalAlignment="Center" 
                Margin="0,15,0,0" 
                Width="250"
                Padding="10,5"/>

        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
              Panel.ZIndex="100"
              Grid.RowSpan="5">
            <Path Style="{StaticResource LoadingSpinnerStyle}"
                  Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>