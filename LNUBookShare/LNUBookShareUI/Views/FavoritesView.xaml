<Window x:Class="LNUBookShareUI.Views.FavoritesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        xmlns:common="clr-namespace:LNUBookShareUI.Common"
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=vm:FavoritesViewModel}"
        Title="Уподобане" Height="700" Width="800" MinWidth="600">

    <Window.Resources>
        

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock>
                            <Hyperlink TextDecorations="None" Foreground="#0078D7">
                                <Run Text="{TemplateBinding Content}"/>
                            </Hyperlink>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <TextBlock TextDecorations="Underline" Foreground="#005A9E">
                                    <Run Text="{TemplateBinding Content}"/>
                                </TextBlock>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                            To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                            To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                            To="10" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                            To="0.3" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                            To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                            To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                            To="0" Duration="0:0:0.2"/>
                            <DoubleAnimation 
                            Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                            To="0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
   
            <RowDefinition Height="Auto"/>
         
            <RowDefinition Height="Auto"/>
      
            <RowDefinition Height="*"/>
         
            <RowDefinition Height="Auto"/>
           
        </Grid.RowDefinitions>

       
        <Button Grid.Row="0" Content="← Назад" 
                Command="{Binding GoBackCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalAlignment="Left" FontWeight="Bold" Width="70" />

    
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
       
                <ColumnDefinition Width="Auto"/>
            
                <ColumnDefinition Width="*"/>
              
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="←" Command="{Binding PreviousPageCommand}" FontWeight="Bold" Width="30"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0">
                    <Run Text="Сторінка:"/>
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                </TextBlock>
                <Button Content="→" Command="{Binding NextPageCommand}" FontWeight="Bold" Width="30"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                <Label Content="Сортувати:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding SortOptions}" 
                          SelectedValue="{Binding SelectedSort}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          VerticalAlignment="Center"
                          MinWidth="100"/>
            </StackPanel>

  
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton Content="Усі"
                             GroupName="StatusFilter" VerticalAlignment="Center"
                             Command="{Binding SetFilterAllCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="All">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="Тільки доступні"
                             GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterAvailableCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Available">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="Тільки видані"
                             GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterIssuedCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Issued">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
            </StackPanel>
        </Grid>


        <TextBlock Grid.Row="2" FontSize="14" Margin="0,0,0,10">
            <Run Text="Знайдено вподобань: "/>
            <Run Text="{Binding TotalResults}" FontWeight="Bold"/>
        </TextBlock>

 
        <ListView Grid.Row="3" ItemsSource="{Binding FavoriteBooks}" HorizontalContentAlignment="Stretch">
         
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Style>

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                        
                                <ColumnDefinition Width="*"/>
                      
                                <ColumnDefinition Width="Auto"/>
                              
                            </Grid.ColumnDefinitions>

                           
                            <Border Grid.Column="0" Width="80" Height="100" Margin="0,0,15,0" VerticalAlignment="Center" Background="Gainsboro" ClipToBounds="True">
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                            </Border>

                   
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">

                                <Button 
                                    Content="{Binding Title}" 
                                    FontSize="16" FontWeight="Bold" 
                                    Margin="0,0,0,5"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0" 
                                    Command="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                />

                                <TextBlock Text="{Binding Author}" FontStyle="Italic" Margin="0,0,0,5"/>

                                <Button 
                                    Content="{Binding OwnerFullName, StringFormat='Власник: {0}'}"
                                    Command="{Binding DataContext.ViewOwnerProfileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding OwnerId}"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                />

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Статус: " FontWeight="Bold"/>
                                    <Run Text="{Binding Status}"/>
                                    <Run Text="  |  "/>
                                    <Run Text="Рік: " FontWeight="Bold"/>
                                    <Run Text="{Binding Year}"/>
                                </TextBlock>

                            </StackPanel>

                            <Button Grid.Column="2" 
                                    Command="{Binding DataContext.RemoveFromFavoritesCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Width="120" Height="30">
                                <TextBlock Text="❤️ Видалити"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

  
        <Button Grid.Row="4" Content="Очистити вподобання" 
                Command="{Binding ClearFavoritesCommand}"
                HorizontalAlignment="Center" Margin="0,10,0,0" Padding="10,5"/>

    </Grid>
</Window>