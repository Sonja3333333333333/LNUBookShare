<Window x:Class="LNUBookShareUI.Views.FavoritesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        xmlns:common="clr-namespace:LNUBookShareUI.Common"
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=vm:FavoritesViewModel}"
        Title="Уподобане" Height="700" Width="800" MinWidth="600">

    <Window.Resources>
        

        <!-- Стиль для Кнопки "Назад" (якщо ти хочеш) -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock>
                            <Hyperlink TextDecorations="None" Foreground="#0078D7">
                                <Run Text="{TemplateBinding Content}"/>
                            </Hyperlink>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <TextBlock TextDecorations="Underline" Foreground="#005A9E">
                                    <Run Text="{TemplateBinding Content}"/>
                                </TextBlock>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Кнопка Назад -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Панель Керування (Сорт, Фільтри, Сторінки) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Лічильник -->
            <RowDefinition Height="*"/>
            <!-- 3: Список книг -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Кнопка "Очистити" -->
        </Grid.RowDefinitions>

        <!-- 0. Кнопка "Назад" -->
        <Button Grid.Row="0" Content="← Назад" 
                Command="{Binding GoBackCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalAlignment="Left" FontWeight="Bold" Width="70" />

        <!-- 1. Панель Керування (як у MainView) -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Пагінація -->
                <ColumnDefinition Width="Auto"/>
                <!-- Сортування -->
                <ColumnDefinition Width="*"/>
                <!-- Фільтри (розтягнуться) -->
            </Grid.ColumnDefinitions>

            <!-- Пагінація -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="←" Command="{Binding PreviousPageCommand}" FontWeight="Bold" Width="30"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0">
                    <Run Text="Сторінка:"/>
                    <Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
                </TextBlock>
                <Button Content="→" Command="{Binding NextPageCommand}" FontWeight="Bold" Width="30"/>
            </StackPanel>

            <!-- Сортування -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                <Label Content="Сортувати:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding SortOptions}" 
                          SelectedValue="{Binding SelectedSort}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          VerticalAlignment="Center"
                          MinWidth="100"/>
            </StackPanel>

            <!-- Фільтри (прив'язані до правого краю) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton Content="Усі"
                             GroupName="StatusFilter" VerticalAlignment="Center"
                             Command="{Binding SetFilterAllCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="All">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="Тільки доступні"
                             GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterAvailableCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Available">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="Тільки видані"
                             GroupName="StatusFilter" VerticalAlignment="Center" Margin="10,0,0,0"
                             Command="{Binding SetFilterIssuedCommand}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStatusFilter}" Value="Issued">
                                    <Setter Property="IsChecked" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- 2. Лічильник -->
        <TextBlock Grid.Row="2" FontSize="14" Margin="0,0,0,10">
            <Run Text="Знайдено вподобань: "/>
            <Run Text="{Binding TotalResults}" FontWeight="Bold"/>
        </TextBlock>

        <!-- 3. Список книг -->
        <ListView Grid.Row="3" ItemsSource="{Binding FavoriteBooks}" HorizontalContentAlignment="Stretch">
            <!-- Стиль, що прибирає рамку ListView і виділення -->
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Style>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Картка (як у MainView) -->
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,8" Height="120">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Картинка -->
                                <ColumnDefinition Width="*"/>
                                <!-- Інфо -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Кнопка -->
                            </Grid.ColumnDefinitions>

                            <!-- Картинка-заглушка (з прив'язкою) -->
                            <Border Grid.Column="0" Width="80" Height="100" Margin="0,0,15,0" VerticalAlignment="Center" Background="Gainsboro" ClipToBounds="True">
                                <Image Source="{Binding CoverPath}" Stretch="UniformToFill" />
                            </Border>

                            <!-- Інфо -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button 
                                    Content="{Binding Title}" 
                                    FontSize="16" FontWeight="Bold" 
                                    Margin="0,0,0,5"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0" 
                                    Command="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                    />
                                <TextBlock Text="{Binding Author}" FontStyle="Italic" Margin="0,0,0,5"/>
                                <!-- Поля, специфічні для "Вподобаних" -->
                                <Button 
                                    Content="{Binding OwnerFullName, StringFormat='Власник: {0}'}"
                                    Command="{Binding DataContext.ViewOwnerProfileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding OwnerId}"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    />
                                <TextBlock>
                                    <Run Text="Статус: "/>
                                    <Run Text="{Binding Status}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Кнопка "Видалити" (сердечко) -->
                            <Button Grid.Column="2" 
                                    Command="{Binding DataContext.RemoveFromFavoritesCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding BookId}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Width="120" Height="30">
                                <TextBlock Text="❤️ Видалити"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 4. Кнопка "Очистити" (згідно з wireframe) -->
        <Button Grid.Row="4" Content="Очистити вподобання" 
                Command="{Binding ClearFavoritesCommand}"
                HorizontalAlignment="Center" Margin="0,10,0,0" Padding="10,5"/>

    </Grid>
</Window>