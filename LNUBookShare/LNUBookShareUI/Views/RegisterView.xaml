<Window x:Class="LNUBookShareUI.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        
        
        d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
        
        Title="Реєстрація"
        Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

            <!-- Заголовок -->
            <TextBlock Text="Реєстрація"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Основна форма -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="20" CornerRadius="5">
                <StackPanel>

                    <!-- Прізвище -->
                    <Label Content="Прізвище" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <!-- 
                        ВИДАЛЕНО: x:Name, TextChanged
                        ДОДАНО: Text="{Binding LastName, ...}"
                    -->
                    <TextBox Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Ім’я -->
                    <Label Content="Ім’я" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Факультет -->
                    <Label Content="Факультет" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <!-- 
                        ВИДАЛЕНО: x:Name, SelectionChanged, <ComboBoxItem>
                        ДОДАНО: ItemsSource, SelectedItem, DisplayMemberPath
                        (Це ПРИПУСКАЄ, що RegisterViewModel завантажить список факультетів)
                    -->
                    <ComboBox Height="30"
                              Margin="0,0,0,10"
                              ItemsSource="{Binding Faculties}"
                              SelectedItem="{Binding SelectedFaculty}"
                              DisplayMemberPath="Name"/>

                    <!-- Email -->
                    <Label Content="Email (університетська пошта)" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Password -->
                    <Label Content="Password" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                  
                    <PasswordBox x:Name="UserPasswordBox"
                                 Height="30"
                                 Margin="0,0,0,10"
                                 VerticalContentAlignment="Center"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Надіслати підтвердження"
                            Margin="0,0,0,10" Height="35" 
                            FontWeight="Bold" IsDefault="True"
                            Command="{Binding RegisterCommand}"
                            CommandParameter="{Binding ElementName=UserPasswordBox}"/>

                    <!-- Посилання на логін -->
                    <TextBlock TextAlignment="Center">
                        <Hyperlink Foreground="Blue" TextDecorations="None"
       
                                   Command="{Binding GoToLoginCommand}"
                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            Уже маєте акаунт? Увійти
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>