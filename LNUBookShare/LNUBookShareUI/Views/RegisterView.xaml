<Window x:Class="LNUBookShareUI.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LNUBookShareUI.Views"
        mc:Ignorable="d"
        
        Title="Реєстрація"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="Реєстрація"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Основна форма -->
            <Border BorderBrush="Gray" BorderThickness="1" Padding="20" CornerRadius="5">
                <StackPanel Width="250" HorizontalAlignment="Center">

                    <!-- Прізвище -->
                    <Label Content="Прізвище" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox x:Name="LastNameTextBox"
                             Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             TextChanged="InputChanged"/>

                    <!-- Ім’я -->
                    <Label Content="Ім’я" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox x:Name="FirstNameTextBox"
                             Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             TextChanged="InputChanged"/>

                    <!-- Факультет -->
                    <Label Content="Факультет" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <ComboBox x:Name="FacultyComboBox"
                              Height="30"
                              Margin="0,0,0,10"
                              SelectionChanged="InputChanged">
                        <ComboBoxItem Content="Фізичний факультет"/>
                        <ComboBoxItem Content="Факультет прикладної математики та інформатики"/>
                        <ComboBoxItem Content="Філологічний факультет"/>
                        <ComboBoxItem Content="Історичний факультет"/>
                        <ComboBoxItem Content="Факультет міжнародних відносин"/>
                    </ComboBox>

                    <!-- Email -->
                    <Label Content="Email (університетська пошта)" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox x:Name="EmailTextBox"
                             Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             TextChanged="InputChanged"/>

                    <!-- Password -->
                    <Label Content="Password" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="30"
                                     Width="250"
                                     Padding="5,0,35,0"
                                     VerticalContentAlignment="Center"
                                     PasswordChanged="InputChanged"/>
                        <TextBox x:Name="VisiblePasswordBox"
                                 Height="30"
                                 Width="250"
                                 Padding="5,0,35,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"
                                 TextChanged="InputChanged"/>
                        <Button x:Name="ShowPasswordButton"
                                Width="25"
                                Height="25"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0"
                                Click="ShowPasswordButton_Click">
                            <TextBlock Text="👁" FontSize="14"/>
                        </Button>
                    </Grid>

                    <!-- Кнопка реєстрації -->
                    <Button x:Name="RegisterButton"
                            Content="Надіслати підтвердження"
                            Margin="0,15,0,10"
                            Height="30"
                            Background="#FFDDDDDD"
                            Foreground="Black"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            FontWeight="Bold"
                            IsEnabled="False"
                            Click="RegisterButton_Click"/>

                    <!-- Посилання на логін -->
                    <TextBlock TextAlignment="Center">
                        
                        <Hyperlink NavigateUri="#" Foreground="Blue">
                            Уже маєте акаунт? Увійти
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>


</Window>
