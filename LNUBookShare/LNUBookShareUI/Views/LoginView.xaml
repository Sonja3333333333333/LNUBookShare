<Window x:Class="LNUBookShareUI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        
        Title="Вхід"
        Height="550" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

            <Image Source="/Images/book.png" 
               Width="80" 
               Height="80" 
               HorizontalAlignment="Center" 
               Margin="0,0,0,20"
               RenderOptions.BitmapScalingMode="HighQuality"/>


            <TextBlock Text="LNUBookShare"
                       FontSize="20"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,5"/>
            <TextBlock Text="програма обміну підручниками"
                       FontSize="12"
                       Foreground="Gray"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="20" CornerRadius="5">
                <StackPanel>

                    <Label Content="Email (університетська пошта)" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <TextBox Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Password" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="UserPasswordBox"
                                 Height="30"
                                 Margin="0,0,0,10"
                                 VerticalContentAlignment="Center"/>


                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Увійти"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=UserPasswordBox}"
                            Height="35" FontWeight="Bold" IsDefault="True"/>

                    <TextBlock TextAlignment="Center" Margin="0,15,0,0">
                        <Hyperlink Foreground="Blue"
                                   TextDecorations="None"
           
                                   Command="{Binding GoToRegisterCommand}"
                                   CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                            Ще немає акаунта? Зареєструватися
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Border>
        </StackPanel>

        <Grid
            Background="#80000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
            Panel.ZIndex="100"
            Grid.RowSpan="5">


            <Path
                Style="{StaticResource LoadingSpinnerStyle}"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>