<Window x:Class="LNUBookShareUI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LNUBookShareUI.Views"
        mc:Ignorable="d"
        


    
        Title="LnuBookShare"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="White">

        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Заголовок -->
                <TextBlock Text="LnuBookShare - платформа обміну підручниками."
                       FontSize="18"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

                <TextBlock Text="Доступ мають лише користувачі з акаунтом @lnu.edu.ua."
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- Панель логіну -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="20" CornerRadius="5">
                    <StackPanel Width="250" HorizontalAlignment="Center">

                        <!-- Поле Email -->
                        <Label Content="Email" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <TextBox x:Name="EmailTextBox"
                             Height="30"
                             Margin="0,0,0,10"
                             VerticalContentAlignment="Center" Text=""/>

                        <!-- Поле Password з кнопкою "око" -->
                        <Label Content="Password" FontSize="12" Foreground="Gray" Margin="0,0,0,2"/>
                        <Grid>
                            <PasswordBox x:Name="PasswordBox"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Width="250"
                                     Padding="5,0,35,0" Password=""/>
                            <TextBox x:Name="VisiblePasswordBox"
                                 Height="30"
                                 Width="250"
                                 VerticalContentAlignment="Center"
                                 Padding="5,0,35,0"
                                 Visibility="Collapsed"/>

                            <!-- Кнопка-іконка "показати пароль" -->
                            <Button x:Name="ShowPasswordButton"
                                Width="25"
                                Height="25"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0"
                                Click="ShowPasswordButton_Click">
                                <TextBlock Text="👁" FontSize="14"/>
                            </Button>
                        </Grid>

                        <!-- Кнопка Увійти -->
                        <Button Content="Увійти"
                            Margin="0,15,0,10"
                            Height="30"
                            Background="#FFDDDDDD"
                            Foreground="Black"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            FontWeight="Bold"
                            Click="LoginButton_Click"/>

                        <!-- Повідомлення про помилку -->
                        <TextBlock x:Name="ErrorMessage"
                               Text="Невірний email або пароль"
                               Foreground="Red"
                               FontSize="12"
                               TextAlignment="Center"
                               Visibility="Collapsed"
                               Margin="0,0,0,10"/>

                        <!-- Посилання реєстрації -->
                        <TextBlock TextAlignment="Center">                        
                        <Hyperlink NavigateUri="#" Foreground="Blue">
                            Ще немає акаунта? Зареєструватися
                        </Hyperlink>
                        </TextBlock>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    



</Window>
