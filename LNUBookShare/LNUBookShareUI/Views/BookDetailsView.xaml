<Window x:Class="LNUBookShareUI.Views.BookDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BookDetailsViewModel}"
        Title="{Binding Book.Title, FallbackValue='Деталі книги'}" 
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
                Content="← Назад" 
                HorizontalAlignment="Left" 
                Margin="0,0,0,15" 
                Padding="10,5"
                Background="Transparent"
                Foreground="{StaticResource TextSecondaryColor}"
                BorderThickness="0"
                Cursor="Hand"
                FontSize="14"
                Command="{Binding GoBackCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.RowSpan="2"
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" 
                        Width="280" 
                        CornerRadius="8"
                        VerticalAlignment="Top" 
                        Margin="0,0,30,0" 
                        Background="#FAFAFA"
                        ClipToBounds="True">
                    <Grid Height="420">
                        <Image Source="{Binding Book.CoverPath}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Book.Title}" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryColor}" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding Book.Author}" 
                                   FontSize="20" 
                                   FontStyle="Italic" 
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,0,0,20"/>

                        <Separator Background="{StaticResource BorderColor}" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </Grid.Resources>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Статус:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock Text="Категорія:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock Text="Рік:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock Text="Видавництво:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock Text="Мова:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock Text="ISBN:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Book.Status}" Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding Book.CategoryName}" Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding Book.Year}" Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding Book.Publisher}" Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding Book.Language}" Foreground="{StaticResource TextPrimaryColor}"/>
                                <TextBlock Text="{Binding Book.Isbn}" Foreground="{StaticResource TextPrimaryColor}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderColor}" Margin="0,10,0,20"/>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Власник книги" FontSize="14" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,5"/>
                            <Button Content="{Binding Book.OwnerFullName}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    FontSize="16"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ViewOwnerProfileCommand}"/>
                            <TextBlock Text="{Binding Book.OwnerEmail}" FontSize="14" Foreground="#888" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,20,0,0">
                    <Button Style="{StaticResource FavoriteToggleButtonStyle}"
                            Command="{Binding ToggleFavoriteCommand}"
                            HorizontalAlignment="Left"
                            MinWidth="200"
                            Height="40">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="♡ Додати в улюблене"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Book.IsFavoritedByCurrentUser}" Value="True">
                                            <Setter Property="Text" Value="❤️ Видалити з улюбленого"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
              Panel.ZIndex="100"
              Grid.RowSpan="2">
            <Path Style="{StaticResource LoadingSpinnerStyle}"
                  Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>