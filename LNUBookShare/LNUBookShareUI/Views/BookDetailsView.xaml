<Window x:Class="LNUBookShareUI.Views.BookDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:LNUBookShareUI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BookDetailsViewModel}"
        Title="{Binding Book.Title, FallbackValue='Деталі книги'}" 
        Height="650" Width="850">

    <Window.Resources>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock>
                        <Hyperlink TextDecorations="None" Foreground="#0078D7">
                            <Run Text="{TemplateBinding Content}"/>
                        </Hyperlink>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#0078D7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <TextBlock TextDecorations="Underline" Foreground="#005A9E">
                                <Run Text="{TemplateBinding Content}"/>
                                </TextBlock>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="40"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад" HorizontalAlignment="Left" 
        Margin="0,0,0,10" Padding="10,5"
        Command="{Binding GoBackCommand}"
        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="68"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                BorderBrush="LightGray" BorderThickness="1" 
                Width="250" Height="450" Margin="0,0,20,0" 
                VerticalAlignment="Top" 
                Background="Gainsboro"
                ClipToBounds="True">
                <Image Source="{Binding Book.CoverPath}" Stretch="UniformToFill" />
            </Border>

            <Grid Grid.Column="1">

                <StackPanel Grid.Column="1" Margin="0,0,50,0">
                    <TextBlock Text="{Binding Book.Title}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Book.Author}" FontSize="20" FontStyle="Italic" Margin="0,5,0,0"/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock FontSize="14" Margin="0,5,0,0">
                        <Run FontWeight="Bold" Text="Статус:"/>
                        <Run Text="{Binding Book.Status}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,5,0,0">
                        <Run FontWeight="Bold" Text="Категорія:"/>
                        <Run Text="{Binding Book.CategoryName}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,15,0,0">
                        <Run FontWeight="Bold" Text="Рік:"/>
                        <Run Text="{Binding Book.Year}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,5,0,0">
                        <Run FontWeight="Bold" Text="Видавництво:"/>
                        <Run Text="{Binding Book.Publisher}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,5,0,0">
                        <Run FontWeight="Bold" Text="Мова:"/>
                        <Run Text="{Binding Book.Language}"/>
                    </TextBlock>
                    <TextBlock FontSize="14" Margin="0,5,0,0">
                        <Run FontWeight="Bold" Text="ISBN:"/>
                        <Run Text="{Binding Book.Isbn}"/>
                    </TextBlock>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Власник" FontSize="16" FontWeight="Bold"/>
                    <Button 
                        Content="{Binding Book.OwnerFullName}"
                        FontSize="14" 
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Margin="0,5,0,0"
                        Command="{Binding ViewOwnerProfileCommand}"
                    />
                    <TextBlock FontSize="14" Margin="0,5,0,0">
                        <Run Text="{Binding Book.OwnerEmail}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>

        <Button Grid.Row="2" 
                Command="{Binding ToggleFavoriteCommand}"
                Margin="0,20,0,0" 
                HorizontalAlignment="Center" 
                Padding="15,7"
                MinWidth="150"
                FontSize="14" Width="150">
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="♡ Вподобати"/>
                        <Setter Property="ToolTip" Value="Додати в улюблене"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Book.IsFavoritedByCurrentUser}" Value="True">
                                <Setter Property="Text" Value="❤️ Видалити"/>
                                <Setter Property="ToolTip" Value="Видалити з улюбленого"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>

        <Grid
            Background="#80000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
            Panel.ZIndex="100"
            Grid.RowSpan="5">


            <Path
                Style="{StaticResource LoadingSpinnerStyle}"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>